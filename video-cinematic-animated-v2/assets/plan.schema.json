{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Video Cinematic Shot Graph",
  "type": "object",
  "required": ["title", "platform", "identity", "style", "shots"],
  "properties": {
    "title": {"type": "string"},
    "preset": {"enum": ["product-ad", "social-reel", "talking-head", "story", "custom"]},
    "platform": {
      "type": "object",
      "required": ["aspect", "max_seconds"],
      "properties": {
        "aspect": {"enum": ["9:16", "16:9", "1:1", "4:5"]},
        "max_seconds": {"type": "number", "maximum": 60}
      }
    },
    "budget": {"type": "object", "properties": {"max_credits": {"type": "number"}}},
    "identity": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "descriptor"],
        "properties": {
          "id": {"type": "string"},
          "kind": {"enum": ["character", "product", "location"]},
          "descriptor": {"type": "string", "description": "Locked text, reused verbatim"},
          "ref_images": {"type": "array", "items": {"type": "string"}},
          "locked": {"type": "boolean", "default": true}
        }
      }
    },
    "style": {
      "type": "object",
      "required": ["look", "light_dir"],
      "properties": {
        "look": {"type": "string"},
        "light_dir": {"enum": ["left", "right", "front", "back", "top", "overcast"]},
        "palette": {"type": "string"}
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "duration", "framing", "camera", "action", "setting", "light", "start_from"],
        "properties": {
          "id": {"type": "string"},
          "duration": {"type": "number", "minimum": 1.5, "maximum": 15},
          "framing": {"type": "string"},
          "camera": {
            "type": "object",
            "required": ["moves"],
            "properties": {
              "moves": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string"}},
              "speed": {"enum": ["slow", "medium", "fast", "whip"]},
              "lens": {"type": "string"}
            }
          },
          "subject_ids": {"type": "array", "items": {"type": "string"}},
          "action": {"type": "string"},
          "weight_cue": {"type": "string"},
          "setting": {"type": "string"},
          "light": {"type": "string"},
          "light_dir": {"type": "string"},
          "mood": {"type": "string"},
          "screen_direction": {"enum": ["left", "right", "toward", "away", "none"]},
          "start_from": {"enum": ["keyframe", "prev_last_frame", "ref", "none"]},
          "keyframe_group": {"type": "string"},
          "tier": {"enum": ["draft", "final"], "default": "draft"},
          "audio": {"enum": ["none", "native", "external"], "default": "none"},
          "axis_note": {"type": "string"},
          "continuity_note": {"type": "string"}
        }
      }
    }
  }
}
